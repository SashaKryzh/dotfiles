[
  {
    "key": "cmd+k",
    "command": "workbench.action.showCommands"
  },
  {
    "key": "shift+cmd+p",
    "command": "-workbench.action.showCommands"
  },
  {
    "key": "cmd+k",
    "command": "glass.openActionsPalette",
    "when": "glassNoModalOpen && isGlassEmptyWorkspace || isGlassEmptyWorkspace && glassActiveModal == 'palette'"
  },
  {
    "key": "shift+cmd+p",
    "command": "-glass.openActionsPalette",
    "when": "glassNoModalOpen && isGlassEmptyWorkspace || isGlassEmptyWorkspace && glassActiveModal == 'palette'"
  },
  {
    "key": "shift+cmd+k",
    "command": "aipopup.action.modal.generate",
    "when": "editorFocus && !composerBarIsVisible"
  },
  {
    "key": "cmd+k",
    "command": "-aipopup.action.modal.generate",
    "when": "editorFocus && !composerBarIsVisible"
  }
]
